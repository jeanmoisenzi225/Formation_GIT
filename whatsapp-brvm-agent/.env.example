# --- WhatsApp Cloud API (Meta for Developers) ---
# Jeton d'accès (temporaire ou permanent via un system user Meta Business)
WHATSAPP_TOKEN=
# Identifiant du numero expediteur WhatsApp Business (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=
# Version de l'API Graph utilisee
WHATSAPP_API_VERSION=v20.0
# Numeros destinataires, format international sans "+", separes par des virgules
# Exemple: 2250700000000,2250500000000
WHATSAPP_RECIPIENTS=

# Envoi hors fenetre de 24h -> obligatoire d'utiliser des message templates
# approuves par Meta. Mettre a "false" seulement pour des tests manuels dans
# les 24h suivant un message recu de la part du destinataire.
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_NEWS_TEMPLATE_NAME=brvm_news_alert
WHATSAPP_RECAP_TEMPLATE_NAME=brvm_boc_recap

# --- Source BRVM ---
BRVM_BASE_URL=https://www.brvm.org
# Categories d'annonces a surveiller (slugs de brvm.org/fr/emetteurs/type-annonces/<slug>)
# separees par des virgules
BRVM_NEWS_CATEGORIES=communiques,franchissements-de-seuil,changements-de-dirigeants,notations-financieres

# --- Divers ---
# Fichier local qui memorise les news deja envoyees et le dernier BOC envoye
STATE_FILE=state.json
